{
	admin off
	auto_https off
	persist_config off
}

:{$PORT} {
	# Health check for Railway: answers once the model is loaded and the server is up.
	handle /healthz {
		rewrite * /api/model-info
		reverse_proxy 127.0.0.1:8004
	}

	# API clients: Authorization: Bearer <API_KEY>
	@apikey header Authorization "Bearer {$API_KEY}"
	handle @apikey {
		reverse_proxy 127.0.0.1:8004
	}

	# Everything else (web UI, docs): HTTP basic auth.
	handle {
		basic_auth {
			{$ADMIN_USERNAME} {$ADMIN_PASSWORD_HASH}
		}
		reverse_proxy 127.0.0.1:8004
	}
}
